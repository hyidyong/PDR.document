APP_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_STORAGE_BUCKET=expense-documents
APP_REPOSITORY_PROVIDER=jdbc
# SET ROLE must persist for the JDBC session. Use Supabase direct connection or session pooler (5432), not transaction pooler (6543).
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=YOUR_DATABASE_USER
SUPABASE_DB_PASSWORD=REPLACE_WITH_SERVER_ONLY_PASSWORD
SUPABASE_DB_ROLE=modit_backend
SUPABASE_DB_MAX_POOL_SIZE=5
